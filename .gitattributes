* text=auto

# YAML files should always use LF (Render.com runs on Linux)
*.yaml text eol=lf
*.yml  text eol=lf

# Shell scripts should always use LF
*.sh  text eol=lf

# JavaScript and HTML are fine with auto-normalized endings
*.js  text
*.html text
*.css text
*.json text
*.md  text

# Never modify .env files — they are git-ignored anyway
.env   text eol=lf
.env.* text eol=lf
