# ─────────────────────────────────────────────────────────
# Quaere.ai — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy to .env locally or set these in your Render.com dashboard.
# Do NOT commit a real .env file — it is git-ignored.

# Provider: "k25" (Moonshot K2.5), "openai-compatible" (Groq/TogetherAI/OpenAI), "ollama" (local), "huggingface", "llamacpp", or "pollinations"
AI_PROVIDER=k25

# ── Moonshot K2.5 settings (used when AI_PROVIDER=k25) ──
# Get your API key from https://moonshot.ai/console
K25_API_KEY=your-moonshot-api-key-here
K25_MODEL=k2.5

# ── Ollama settings (used when AI_PROVIDER=ollama) ─────────
# Ollama runs locally at http://localhost:11434
OLLAMA_MODEL=llama3

# ── OpenAI-compatible settings (used when AI_PROVIDER=openai-compatible) ──
# The base URL of the OpenAI-compatible API.
# Examples:
#   https://api.groq.com/openai/v1        (Groq)
#   https://api.together.ai/v1            (TogetherAI)
#   https://api.openai.com/v1             (OpenAI)
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# API key for the chosen provider
GROQ_API_KEY=gsk-your-key-here

# The model to use (e.g., llama-3.3-70b-versatile, gpt-4o-mini, meta-llama/llama-70b)
OPENAI_MODEL=llama-3.3-70b-versatile

# ── Hugging Face settings (used when AI_PROVIDER=huggingface) ──
# Your Hugging Face API key (from https://huggingface.co/settings/tokens)
HF_API_KEY=hf-your-key-here
# The model repo ID (e.g., yourname/quaere-socratic)
HF_MODEL_ID=yourname/quaere-socratic
# OR a custom Inference API endpoint URL
HF_ENDPOINT=https://api-inference.huggingface.co/models/yourname/quaere-socratic

# ── llama.cpp settings (used when AI_PROVIDER=llamacpp) ──
# URL of your llama-server instance (OpenAI-compatible endpoint)
LLAMA_CPP_URL=http://localhost:8080
# The GGUF model name (llama-server ignores this but keep for reference)
LLAMA_CPP_MODEL=quaere-socratic-q4_k_m.gguf

# ── Pollinations settings (used when AI_PROVIDER=pollinations) ──
# Optional API key (not strictly required for free tier, but recommended for rate limits)
POLLINATIONS_API_KEY=your-pollinations-key-here
# Model to use for text chat (e.g., openai-small, mistral, llama, etc.)
POLLINATIONS_MODEL=openai-small

# ── Pollinations image settings (used by Goddess Lalita image page) ──
# Provider for the image endpoint: "pollinations" (direct prompt) or "pollinations-text" (expand prompt first)
LALITA_AI_PROVIDER=pollinations
# Image model to use (e.g., flux, flux-real, flux-pro, etc.)
POLLINATIONS_IMAGE_MODEL=flux

# ── Pollinations video settings (used by Lord Shiva video page) ──
# Provider for the video endpoint: "pollinations" (direct prompt) or "pollinations-text" (expand prompt first)
SHIVA_AI_PROVIDER=pollinations
# Video model to use (e.g., seedance-2.0-fast, etc.)
POLLINATIONS_VIDEO_MODEL=seedance-2.0-fast

# ── Claude 3.5 Sonnet settings (used by Aarambha page) ──
# Get your API key from https://console.anthropic.com/
CLAUDE_API_KEY=your-anthropic-api-key-here
# Claude model to use (e.g., claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Base URL for Claude API (default: https://api.anthropic.com/v1)
CLAUDE_BASE_URL=https://api.anthropic.com/v1

CLAUDE_API_KEY=